(function (w, d, undefined) {

  // LOGOUT MESSAGE BROADCASTING
  const bc = new BroadcastChannel("auth_channel");
  bc.addEventListener('message', ({ data}) => {
    if(data === 'logout') {
      $('#admin_main').html('').hide();
      $('.admin_panel_switch').html('').hide();
    }
  });

  if (w.GSC.init) {
    w.GSC.data = {} || w.GSC.data;

    // GSC.PingDot() - blinking dot
    if (!w.GSC.PingDot) w.GSC.PingDot = function (el, status = true) {
      if (!el) return;
      if (status) {
        status = "green";
      } else {
        status = "red";
      }
      $(el).html("&#8226;").css({
        color: status,
        opacity: 1
      }).fadeTo(2000, 0);
    }

    // GSC.GetCsvInfo()
    if (!w.GSC.GetCsvInfo) w.GSC.GetCsvInfo = function () {
      if (w.GSC.offline) {
        return GSC.PingDot("#csv_ping", false);
      }

      // API: GetCsvInfo
      $.get("/{{ cfg.admin }}/GetCsvInfo?" + Date.now(), function (data) {
          GSC.PingDot("#csv_ping");
          var content = "";
          var now = ~~(Date.now() / 1000);
          moment.locale("{{ lang }}");
          for (x in data.data) {
            var link = x;
            var csv = data.data[x]["csv"];
            var lines = data.data[x]["lines"];
            var sheet = data.data[x]["sheet"];
            if (!data.data[x]["sheet"]) continue;
            if (sheet) {
              link =
                '<a rel=noopener target=_blank title="{{ l.a_edit_gsheet_ttip }}" style="font-size:1.2rem;border-radius:2px;padding:3px;" ' +
                'class="orange mono white-text bold nowrap" href="' +
                'https://docs.google.com/spreadsheets/d/' +
                sheet + '/edit">&nbsp;' +
                x + '&nbsp;</a>&nbsp;<a rel=noopener target=_blank title="{{ l.a_download_csv_ttip }}"' +
                ' style="font-size:1.2rem;border-radius:2px;padding:3px;" class="csv' + x +  ' bold blue white-text mono nowrap" ' +
                'href="https://docs.google.com/spreadsheets/d/e/' +
                csv + '/pub?output=csv">&nbsp;' +
                lines + '&nbsp;</a>&nbsp;';
            }
            content += ('<div style="margin:2px;" class="center">' +
              link +
              '&nbsp;&nbsp;<span class="nowrap">&nbsp;<span class=csv' +
              x +
              '>' +
              moment.duration(Math.abs(~~((now - data.data[x]['timestamp']))), 'seconds').humanize() +
              '</span></span></div>'
            );
          }
          $("#a_update_info").html(content);
        })
        .fail(function (e) {
          GSC.PingDot("#csv_ping", false);
          $('#admin_main').html('').hide();
          $('.admin_panel_switch').html('').hide();
        });
    }

    // GSC.AdminUI()
    if (!w.GSC.AdminUI) w.GSC.AdminUI = function () {
      $("#admin_main div").addClass("a_reset");
      $("#admin_main h2").addClass("a_reset a_h2");
      $("#admin_main h4").addClass("a_reset a_h4");
      $("#admin_main h5").addClass("a_reset a_h5");
      $("#admin_main p").addClass("a_reset");
      if (w.GSC.touch) {
        if ($(".tooltipped")) $(".tooltipped").tooltip("destroy");
      }

      // switch CSS debugger ON/OFF
      $('#cssdebugger').click(function () {
        if (getCookie('debug')) {
          $('#cssdebugger').removeClass('red').addClass('blue');
          delCookie('debug');
          location.replace(location.href.split('?')[0] + "?{{ nonce }}");
        } else {
          $('#cssdebugger').removeClass('blue').addClass('red');
          setCookie('debug', 1);
          location.replace(location.href.split('?')[0] + "?{{ nonce }}");
        }
      });

      // show MODEL-X details
      $('#modelx-switch').click(function () {
          $('#modelx').removeClass('hide').show();
          $('#modelx-switch').hide();
      });

      // press LOGOUT
      $('#logout').click(function () {
        bc.postMessage('logout');
      });

{{#dbg}}
{{#admin_group_admin}}
      // switch PHP debugger ON/OFF
      $('#phpdebugger').click(function () {
        if (getCookie('tracy-debug')) {
          $('#phpdebugger').removeClass('red').addClass('blue');
          delCookie('tracy-debug');
          location.replace(location.href.split('?')[0] + "?{{ nonce }}");
        } else {
          $('#phpdebugger').removeClass('blue').addClass('red');
          setCookie('tracy-debug', '{{ DEBUG_COOKIE }}');
          location.replace(location.href.split('?')[0] + "?{{ nonce }}");
        }
      });
{{/admin_group_admin}}
{{/dbg}}
    }
  }
})(window, document);

